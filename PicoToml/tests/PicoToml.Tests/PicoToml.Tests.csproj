<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
<IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);__PicoSerDe_$(AssemblyName.Replace('.','_').Replace('-','_').Replace(' ','_'))</InterceptorsNamespaces>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Tomlyn" />
    <!-- Generator-driver tests (recursive-member diagnostics) need the generator
         as a normal assembly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoToml\PicoToml.csproj" />
    <ProjectReference
      Include="..\..\src\PicoToml.Gen\PicoToml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <!-- The Roslyn reference-set fixture (shared/RoslynProbe.cs) - linked, not referenced, for the
         same reason as shared/TestText.cs: three test projects drive a generator in-proc and each
         used to carry its own copy of the same 20-line PlatformReferences(). Test-only. -->
    <Compile Include="..\..\..\shared\RoslynProbe.cs" Link="RoslynProbe.cs" />
  </ItemGroup>
</Project>
