<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoBench" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\shared\BenchRoleGuard.cs" Link="BenchRoleGuard.cs" />
    <Compile Include="..\..\..\shared\BenchProtocol.cs" Link="BenchProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoMsgPack\PicoMsgPack.csproj" />
    <ProjectReference
      Include="..\..\src\PicoMsgPack.Gen\PicoMsgPack.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
