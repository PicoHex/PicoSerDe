<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      JIT ONLY. This benchmark cannot run under NativeAOT and must not claim to:
      MessagePack-CSharp builds formatters for enums and generic collections at run
      time (MakeGenericType + Activator.CreateInstance), which NativeAOT cannot do.
      Its models carry DayOfWeek, Dictionary<string,string> and List<int>, so an AOT
      publish dies on the first complex model with MissingMethodException.

      The AOT-vs-AOT numbers come from ../PicoMsgPack.Benchmarks.Aot, whose models
      are restricted to statically resolvable types.
    -->
    <PublishAot>false</PublishAot>
    <TrimMode>partial</TrimMode>
<IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PicoBench" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\shared\BenchModels.cs" Link="BenchModels.cs" />
    <Compile Include="..\..\..\shared\BenchRoleGuard.cs" Link="BenchRoleGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoMsgPack\PicoMsgPack.csproj" />
    <ProjectReference
      Include="..\..\src\PicoMsgPack.Gen\PicoMsgPack.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
