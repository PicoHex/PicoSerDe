<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <!-- Shared generator build configuration (TFM, analyzer flags, packaging, and the
       shared/Gen compile list). The imported file explains itself and its one Exclude. -->
  <Import Project="..\..\..\shared\Gen\PicoSerDe.Gen.props" />

  <PropertyGroup>
    <PackageId>PicoMsgPack.Gen</PackageId>
    <Description>PicoMsgPack source generator — AOT-compatible MessagePack serialization code generation for PicoHex</Description>
    <PackageTags>PicoHex;MessagePack;AOT;Source Generator;Roslyn;Analyzer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- MessagePack emits fused element loops, so it is one of the two generators that
         compile the shared emitter the common list excludes. -->
    <Compile Include="..\..\..\shared\Gen\FusedEmit.cs" Link="Gen\FusedEmit.cs" />
  </ItemGroup>
</Project>
