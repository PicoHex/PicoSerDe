<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
<IsPackable>false</IsPackable>
    <!-- IL2026/IL3050: TUnit reflection (test-only). PICOSERDE002: the hint-name
         collision fixtures intentionally collide. PICOSERDE003: recursive fixtures
         intentionally exercise the TOML/YAML/INI limitation; PICOSERDE005: the anonymous
         collection fixtures intentionally exercise the non-JSON limitation; PICOSERDE001:
         RvNullableEdges.Set (HashSet<...>) is a non-JSON shape that must degrade loudly.
         All of these warnings are the tested behavior. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;PICOSERDE001;PICOSERDE002;PICOSERDE003;PICOSERDE004;PICOSERDE005</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated code must be nullability-clean (review P2-1). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8619;CS8620;CS8625</WarningsAsErrors>
    <Features>Interceptors</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);__PicoSerDe_$(AssemblyName.Replace('.','_').Replace('-','_').Replace(' ','_'))</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="MessagePack" />
    <!-- Generator-driver tests (anonymous collection diagnostics) need Roslyn
         and the generator assemblies as normal references. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- All 5 format libraries -->
  <ItemGroup>
    <ProjectReference Include="..\..\PicoJetson\src\PicoJetson\PicoJetson.csproj" />
    <ProjectReference Include="..\..\PicoIni\src\PicoIni\PicoIni.csproj" />
    <ProjectReference Include="..\..\PicoToml\src\PicoToml\PicoToml.csproj" />
    <ProjectReference Include="..\..\PicoYaml\src\PicoYaml\PicoYaml.csproj" />
    <ProjectReference Include="..\..\PicoMsgPack\src\PicoMsgPack\PicoMsgPack.csproj" />
    <ProjectReference Include="..\..\PicoSerDe.Core\src\PicoSerDe.Core.csproj" />
  </ItemGroup>

  <!-- All 5 source generators. ReferenceOutputAssembly="true" so
       AnonCollectionDiagnosticTests can drive each generator in-proc. -->
  <ItemGroup>
    <ProjectReference
      Include="..\..\PicoJetson\src\PicoJetson.Gen\PicoJetson.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference
      Include="..\..\PicoIni\src\PicoIni.Gen\PicoIni.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference
      Include="..\..\PicoToml\src\PicoToml.Gen\PicoToml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference
      Include="..\..\PicoYaml\src\PicoYaml.Gen\PicoYaml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference
      Include="..\..\PicoMsgPack\src\PicoMsgPack.Gen\PicoMsgPack.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
  </ItemGroup>

  <!-- Shared models -->
  <ItemGroup>
    <Compile Include="..\..\shared\CrossValidationModels.cs" Link="CrossValidationModels.cs" />
    <!-- The capability model is compiled from the SAME source the five generators
         link, so the tests assert against the real tables (no InternalsVisibleTo:
         the file is linked into five assemblies, so "internal" would be five copies). -->
    <Compile Include="..\..\shared\Gen\FormatCapabilities.cs" Link="Gen\FormatCapabilities.cs" />
    <Compile Include="..\..\shared\Gen\DecisionTables.cs" Link="Gen\DecisionTables.cs" />
  </ItemGroup>
</Project>
