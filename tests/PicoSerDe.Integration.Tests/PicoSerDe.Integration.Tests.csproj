<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
<IsPackable>false</IsPackable>
    <!-- IL2026/IL3050: TUnit reflection (test-only). PICOSERDE002: the hint-name
         collision fixtures intentionally collide. PICOSERDE003: recursive fixtures
         intentionally exercise the TOML/YAML/INI limitation; both warnings are the tested behavior. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;PICOSERDE002;PICOSERDE003</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated code must be nullability-clean (review P2-1). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8619;CS8620;CS8625</WarningsAsErrors>
    <Features>Interceptors</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);__PicoSerDe_$(AssemblyName.Replace('.','_').Replace('-','_').Replace(' ','_'))</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <!-- All 5 format libraries -->
  <ItemGroup>
    <ProjectReference Include="..\..\PicoJetson\src\PicoJetson\PicoJetson.csproj" />
    <ProjectReference Include="..\..\PicoIni\src\PicoIni\PicoIni.csproj" />
    <ProjectReference Include="..\..\PicoToml\src\PicoToml\PicoToml.csproj" />
    <ProjectReference Include="..\..\PicoYaml\src\PicoYaml\PicoYaml.csproj" />
    <ProjectReference Include="..\..\PicoMsgPack\src\PicoMsgPack\PicoMsgPack.csproj" />
    <ProjectReference Include="..\..\PicoSerDe.Core\src\PicoSerDe.Core.csproj" />
  </ItemGroup>

  <!-- All 5 source generators -->
  <ItemGroup>
    <ProjectReference
      Include="..\..\PicoJetson\src\PicoJetson.Gen\PicoJetson.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\PicoIni\src\PicoIni.Gen\PicoIni.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\PicoToml\src\PicoToml.Gen\PicoToml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\PicoYaml\src\PicoYaml.Gen\PicoYaml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\PicoMsgPack\src\PicoMsgPack.Gen\PicoMsgPack.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- Shared models -->
  <ItemGroup>
    <Compile Include="..\..\shared\CrossValidationModels.cs" Link="CrossValidationModels.cs" />
  </ItemGroup>
</Project>
