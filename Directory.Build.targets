<Project>
  <!--
    PublishAotIfRequested: when PublishAotOnRun is true, intercepts dotnet run
    to publish as AOT first, then execute the native binary.
    Gates: only for Exe projects (libraries cannot self-publish).
  -->
  <!--
    Aggressive tier implementation. Lives here (after the project file) so a
    per-project <AotOptimizationLevel>aggressive</AotOptimizationLevel>
    declaration is visible when this block evaluates. PublishAot/TrimMode/ILC
    trinity are already set by the minimal tier in Directory.Build.props;
    this block adds the size-optimization and no-debug-info overrides.
  -->
  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'aggressive'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <PublishTrimmed>true</PublishTrimmed>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcDisableReflection>true</IlcDisableReflection>
    <IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <IlcGenerateUnwindStackTraceData>false</IlcGenerateUnwindStackTraceData>
  </PropertyGroup>

  <!-- netstandard2.0 must NEVER AOT. Only source generators (PicoXxx.Gen)
       remain on netstandard2.0 - evaluated here where TFM is known. -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- Libraries: declare trim-compatible (net8.0+ TFMs only, i.e. not
       netstandard2.0 generators). IsAotCompatible lives in
       Directory.Build.props; IsTrimmable must be set here where the TFM
       identifier is known (netstandard2.0 does not support IsTrimmable -
       NETSDK1212). -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <Target
    Name="PublishAotIfRequested"
    BeforeTargets="Run"
    Condition="'$(PublishAotOnRun)' == 'true' and '$(OutputType)' == 'Exe'"
  >
    <Message Text="Publishing AOT build to $(PublishDir)..." Importance="high" />
    <PropertyGroup>
      <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
      <_AotPublishDir>$(BaseIntermediateOutputPath)aot-publish\</_AotPublishDir>
    </PropertyGroup>
    <Exec
      Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot;
        -c $(Configuration)
        -r $(RuntimeIdentifier)
        -p:PublishAot=true
        -o &quot;$(_AotPublishDir)&quot;"
    />
    <Exec
      Command="&quot;$(_AotPublishDir)$(AssemblyName)$(TargetExt)&quot;"
      WorkingDirectory="$(_AotPublishDir)"
    />
  </Target>
</Project>
