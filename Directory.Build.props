<Project>
  <PropertyGroup>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <Version>0.0.0-dev</Version>
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Every restored project gets a packages.lock.json, and CI restores with
         RestoreLockedMode=true: a floating version (see Directory.Packages.props)
         can only move when a refreshed lock is committed, never silently mid-build.
         Moving them is the deps-refresh workflow's job (.github/workflows/deps-refresh.yml),
         which is what makes the floating versions move at all. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generated code must stay nullability-clean across the whole solution:
         promote the reference-nullability warnings to errors here so any format
         or generator regression fails the build, not just the two test projects
         that opted in individually. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8619;CS8620;CS8625</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);__PicoSerDe_$(AssemblyName.Replace('.','_').Replace('-','_').Replace(' ','_'))</InterceptorsNamespaces>
    <Features>$(Features);Interceptors</Features>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- ===== AOT Strategy ===== -->

  <!--
    AotOptimizationLevel:
      minimal  - Tests and default. PublishAot + TrimMode only, fast compilation.
      aggressive - Samples and Benchmarks. Full trimming, no reflection, no debug info.
    Override per-project via <AotOptimizationLevel>aggressive</AotOptimizationLevel>.
  -->
  <PropertyGroup>
    <AotOptimizationLevel Condition="'$(AotOptimizationLevel)' == ''">minimal</AotOptimizationLevel>
  </PropertyGroup>

  <!--
    Restore must be RID-neutral, or the lock files cannot be host-independent.
    PublishAot=true makes the SDK infer PublishRuntimeIdentifier =
    $(NETCoreSdkPortableRuntimeIdentifier) and append it to RuntimeIdentifiers AT
    RESTORE, which bakes a `net10.0/<host-rid>` section into every executable's
    packages.lock.json. A lock generated on win-x64 then fails NU1004 on the
    linux/osx CI legs ("runtime identifiers have changed"), and the other way
    round, so the committed lock would depend on who last refreshed it.
    Disabling the default keeps RuntimeIdentifiers empty unless a RID is asked
    for: every `dotnet publish` in this repo passes an explicit -r (ci.yml,
    scripts, docs), and the PublishAotOnRun target below always passes -r too.
    A publish WITHOUT -r for an AOT project now needs the -r it always implied.
  -->
  <PropertyGroup>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AotOptimizationLevel)' == 'minimal'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <TrimMode Condition="'$(TrimMode)' == ''">full</TrimMode>
    <!-- NOTE: the classic Ilc* MSBuild properties (IlcTrimMetadata,
         IlcFoldIdenticalMethodBodies, IlcDisableReflection, ...) were removed
         in .NET 10 SDK (>= 10.0.400) and are silently ignored - ILC uses its
         built-in defaults. Size levers now: StackTraceSupport,
         UseSystemResourceKeys, InvariantGlobalization (see csproj-format
         skill "Ilc* MSBuild properties are GONE"). -->
  </PropertyGroup>


  <!--
    The aggressive tier is implemented in Directory.Build.targets, NOT here:
    this file evaluates BEFORE the project file, so a per-project
    <AotOptimizationLevel>aggressive</AotOptimizationLevel> would never match
    a conditional block in this file (the value is still 'minimal' here).
    Declare the tier in the csproj; the implementation lives in the targets.
    netstandard2.0 must NEVER AOT - the guard lives in Directory.Build.targets
    (evaluated after the SDK sets TargetFrameworkIdentifier).
    Libraries declare IsAotCompatible here unconditionally; the guard flips it
    back to false for netstandard2.0 generator projects.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- PublishAotOnRun: dotnet run auto-publishes as AOT in CI only. -->
  <PropertyGroup>
    <PublishAotOnRun Condition="'$(PublishAotOnRun)' == '' and '$(CI)' == 'true'">true</PublishAotOnRun>
    <PublishAotOnRun Condition="'$(PublishAotOnRun)' == ''">false</PublishAotOnRun>
  </PropertyGroup>


  <!-- ═══════════════════════════════════════════════════════
       NuGet package icon (the PicoHex family logo)

       The two halves below are a pair and must stay together: PackageIcon
       names the entry inside the package, the None item actually puts the
       file there at the package root. Remove either one and `dotnet pack`
       fails with NU5046 (the icon file does not exist in the package).

       $(MSBuildThisFileDirectory) resolves against THIS file, so the icon is
       always the repository root icon.png, no matter how deep the packing
       project sits. Guarding the item on IsPackable is safe in a props file:
       MSBuild evaluates every item in a pass after every property, so the
       condition already sees the value the csproj body declares.

       PNG here and not the SVG the READMEs use: PackageIcon accepts only PNG
       and JPG. The vector logo lives at assets/picohex.svg.

       (No literal double hyphen appears above: XML comments may not contain
       one, and a props file that does not parse loses every property it
       declares, which surfaces as NU1015, not as a syntax error.)
       ═══════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
