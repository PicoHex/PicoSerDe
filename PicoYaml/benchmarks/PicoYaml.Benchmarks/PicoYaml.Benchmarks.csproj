<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PicoBench" />
    <!-- The CoreCLR-only equivalent arm (YamlDotNetTypedArms.cs). It is deliberately not part
         of the AOT table: under NativeAOT Deserialize<T> throws MissingMethodException and
         Serialize silently emits `{}`, so no like-for-like arm exists there. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\shared\BenchModels.cs" Link="BenchModels.cs" />
    <Compile Include="..\..\..\shared\BenchRoleGuard.cs" Link="BenchRoleGuard.cs" />
    <Compile Include="..\..\..\shared\BenchProtocol.cs" Link="BenchProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoYaml\PicoYaml.csproj" />
    <ProjectReference
      Include="..\..\src\PicoYaml.Gen\PicoYaml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
