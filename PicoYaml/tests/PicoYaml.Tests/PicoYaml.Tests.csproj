<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IsPackable>false</IsPackable>
    <!-- IL2026/IL3050: TUnit reflection (test-only). PICOSERDE004: the
         NestedSeqInts fixture deliberately uses List<List<int>> so the test can
         assert that the diagnostic fires and that the member is dropped; that
         warning is the tested behaviour (same convention as
         tests/PicoSerDe.Integration.Tests). -->
    <NoWarn>$(NoWarn);IL2026;IL3050;TUnitAssertions0005;PICOSERDE004</NoWarn>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoYaml\PicoYaml.csproj" />
    <ProjectReference
      Include="..\..\src\PicoYaml.Gen\PicoYaml.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <Compile Include="..\..\..\shared\CrossValidationModels.cs" Link="CrossValidationModels.cs" />
  </ItemGroup>
</Project>
