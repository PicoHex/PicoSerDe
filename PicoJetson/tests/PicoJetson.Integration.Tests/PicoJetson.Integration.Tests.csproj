<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IsPackable>false</IsPackable>
    <!-- PICOSERDE001 is NOT here: PairCoverageDto.Kvp (KeyValuePair), .Tup (Tuple) and
         DegradationDto.Zone (TimeZoneInfo) are deliberately unserializable fixtures and
         the warning they produce is the tested behaviour (Task 5 / D-6), so it is
         suppressed at those fixtures with `#pragma warning disable PICOSERDE001`
         (TypeCoverageTests.cs). A project-wide NoWarn would also silence the next member
         dropped by a real mistake; the pragma silences the three fixtures only. -->
    <NoWarn>$(NoWarn);IL2026;IL3050;PICOSERDE004</NoWarn>
    <!-- Compile-time guard: generated code must preserve reference-nullability
         annotations in declaration positions (List<string?>,
         Dictionary<string,object?>, record ctor params) — a regression fails the
         build here, exactly like nullable-enabled consumers that promote these
         warnings to errors. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8619;CS8620</WarningsAsErrors>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>Interceptors</Features>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);__PicoSerDe_$(AssemblyName.Replace('.','_').Replace('-','_').Replace(' ','_'))</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PicoJetson\PicoJetson.csproj" />
    <ProjectReference
      Include="..\..\src\PicoJetson.Gen\PicoJetson.Gen.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <Compile Include="..\..\..\shared\CrossValidationModels.cs" Link="CrossValidationModels.cs" />
    <!-- The line-ending-neutral comparison for block-literal expectations in this project
         (ColdThrowMessageTests pins a """…""" message table against a string.Join("\n", …)).
         Test-only: linked, not referenced — see shared/TestText.cs and TestTextUniformTests
         in the integration suite. -->
    <Compile Include="..\..\..\shared\TestText.cs" Link="TestText.cs" />
  </ItemGroup>
</Project>
