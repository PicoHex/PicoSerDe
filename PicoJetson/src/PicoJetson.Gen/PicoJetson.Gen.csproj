<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot">
  <!-- Shared generator build configuration (TFM, analyzer flags, packaging, and the
       shared/Gen compile list). The imported file explains itself and its one Exclude. -->
  <Import Project="..\..\..\shared\Gen\PicoSerDe.Gen.props" />

  <PropertyGroup>
    <PackageId>PicoJetson.Gen</PackageId>
    <Description>PicoJetson.Gen — AOT-compatible JSON source generator. Generates zero-reflection ISerializer&lt;T&gt;/IDeserializer&lt;T&gt; implementations at compile time for PicoHex.</Description>
    <PackageTags>PicoHex;JSON;AOT;Source Generator;Roslyn;Analyzer;JSON Serializer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON emits fused element loops, so it is one of the two generators that compile
         the shared emitter the common list excludes. -->
    <Compile Include="..\..\..\shared\Gen\FusedEmit.cs" Link="Gen\FusedEmit.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PicoJetson.Integration.Tests" />
  </ItemGroup>
</Project>
